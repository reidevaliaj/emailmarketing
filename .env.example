# =============================================================================
#  Email Marketing App — environment configuration
#  Copy to `.env` and fill in real values. NEVER commit the real .env.
#  Every variable below is consumed in app/config.py (Settings).
# =============================================================================

# ---- App / runtime --------------------------------------------------------
APP_NAME="Email Marketing"
APP_ENV=production                       # production | development | test
APP_BASE_URL=https://dashboard.cod-st.com  # DECIDED. Used for unsubscribe links + List-Unsubscribe headers
APP_DEBUG=false
APP_TIMEZONE=Europe/Berlin               # presentation timezone; storage is always UTC

# Secrets — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-session-secret  # signs the login session cookie
JWT_SECRET=change-me-jwt-secret          # reserved for token auth (unused by default)
UNSUBSCRIBE_SECRET=change-me-unsub-secret # signs unsubscribe + one-click tokens (keep stable!)

# ---- Initial admin (seed_admin.py) ---------------------------------------
APP_ADMIN_EMAIL=admin@cod-st.com
APP_ADMIN_INITIAL_PASSWORD=change-me-on-first-login  # user is forced to change this at first login

# ---- Database -------------------------------------------------------------
# Async URL (FastAPI). Sync URL (Celery) is derived automatically in config.py.
POSTGRES_URL=postgresql+asyncpg://emailmarketing:CHANGE_ME@postgres:5432/emailmarketing
# Compose-only convenience vars (used by docker-compose postgres service):
POSTGRES_USER=emailmarketing
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=emailmarketing

# ---- Redis (broker + rate limiter + dedup) -------------------------------
REDIS_URL=redis://redis:6379/0

# ---- Postal (mail delivery engine) ---------------------------------------
# Set POSTAL_USE_MOCK=true to run the whole app WITHOUT a live Postal server.
POSTAL_USE_MOCK=true
POSTAL_API_URL=https://postal.cod-st.com         # base URL of your Postal install
POSTAL_API_KEY=CHANGE_ME_POSTAL_SERVER_API_KEY   # server-level API credential from Postal
POSTAL_MESSAGE_PATH=/api/v1/send/message         # Postal send endpoint path
POSTAL_WEBHOOK_SHARED_SECRET=CHANGE_ME_WEBHOOK_SECRET  # verifies inbound Postal webhooks

# ---- Sending identity / DNS ----------------------------------------------
SENDING_DOMAIN=marketing.cod-st.com              # DECIDED — dedicated marketing subdomain
DEFAULT_FROM_NAME="COD-ST"
DEFAULT_FROM_EMAIL=news@marketing.cod-st.com     # must be on SENDING_DOMAIN
DKIM_SELECTOR=postal
DMARC_REPORT_EMAIL=dmarc@cod-st.com
# Optional: comma-separated sending IPs, used only for PTR/rDNS preflight checks.
SENDING_IPS=89.117.49.213

# ---- Rate pacing & warming (Section 6.3 / Section 4) ---------------------
# Contabo enforces ~25 emails/min outbound. Stay safely under it.
RATE_GLOBAL_PER_MINUTE=20        # global send cap (whole system). <= Contabo's ~25/min
RATE_PER_DOMAIN_PER_MINUTE=6     # per recipient-domain cap (B2B servers throttle)
PER_IP_DAILY_CAP=2000            # warming cap per sending IP per day (raise as you warm up)
SEND_MAX_RETRIES=5               # transient-failure retry attempts
SEND_RETRY_BACKOFF_SECONDS=30    # base for exponential backoff

# ---- Worker concurrency ---------------------------------------------------
CELERY_WORKER_CONCURRENCY=4

# ---- Uploads (must be a shared volume between app + worker containers) -----
UPLOAD_DIR=/var/lib/emailmarketing/uploads

# ---- Verification (Section 7b) -------------------------------------------
VERIFY_DNS_TIMEOUT_SECONDS=3.0   # short DNS timeout; timeouts => 'unknown'
VERIFY_DNS_CONCURRENCY=80        # concurrent in-flight DNS lookups
VERIFY_PROVIDER=inhouse          # inhouse | external (external is a stub for now)

# ---- Import-time free-provider filter (Section 8) ------------------------
# Default ON. Comma-separated domains/prefixes excluded at import (B2B only).
# Editable in the UI too; this is just the seed/default list.
FREE_PROVIDER_FILTER_DEFAULT=true
